{
  "name": "codes",
  "productName": "Codes",
  "version": "0.2.0",
  "description": "Codes 0.2 - Lightweight desktop IDE for JavaScript, HTML and CSS",
  "main": "src/main.js",
  "private": true,
  "license": "MIT",
  "author": "Codes",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
